{
  "folders": [
    {
      "name": "Advance Storage System",
      "path": "../"
    }
  ],
  "settings": {
    "Lua.diagnostics.libraryFiles": "Disable",
    "Lua.workspace.library": [
      "${workspaceFolder}/.vscode/luacs-annotations/Library/Client",
      // "${workspaceFolder}/.vscode/luacs-annotations/Library/Server"
    ],
    "Lua.workspace.preloadFileSize": 10000,
    "Lua.workspace.maxPreload": 50000,
    "Lua.diagnostics.disable": [
      "missing-fields"
    ],
    "Lua.diagnostics.workspaceDelay": 300000,
    "Lua.workspace.ignoreDir": ["**/*_test.lua"],
    "Lua.diagnostics.ignoredFiles": "Disable"
  }
}
